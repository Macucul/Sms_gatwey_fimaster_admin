# Example environment file for Sms_gatwey_fimaster_admin gateway

# Redis
REDIS_URL=redis://redis:6379/0

# Shared secret for HMAC signing - set to a strong secret in production
GATEWAY_SECRET=replace_with_a_strong_secret

# Firebase configuration (optional)
FIREBASE_BASE=
FIREBASE_AUTH=

# Admin token used by the /users endpoint
ADMIN_TOKEN=

# TTL (seconds) for idempotency keys in Redis
IDEMPOTENCY_TTL=604800
